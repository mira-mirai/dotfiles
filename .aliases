# common command aliases
alias rm='rm -i'        # ask before deleting
alias cp='cp -i'        # ask before overwriting
alias mv='mv -i'        # ask before overwriting
alias mkdir='mkdir -p'  # create missing parent folders, no error if it exists
alias la='ls -la'
alias ll='ls -l'

# moving up folders
alias ..='cd ..'
alias ...='cd ../..'

# git aliases
alias gs="git status" #this overrides ghostscript
alias ga="git add"
alias gc="git commit"
alias gl="git log"
alias gp="git push"

# colored ls output, the same on macOS and linux:
#   folders: bold blue   symlinks: bold cyan   programs: bold green   sockets: bold magenta
#   pipes: yellow        devices: bold yellow
#   setuid: white on red   setgid: black on yellow   world-writable folders: green background
# macOS (LSCOLORS) and linux (LS_COLORS) spell this differently, so both are written out.
# linux's default extension colors (archives red, images magenta...) are left out on purpose,
# since macOS's ls can't do them and red already means "removed/changed"
export CLICOLOR=1
export LSCOLORS='ExGxFxdxCxDxDxhbadacec'
export LS_COLORS='di=01;34:ln=01;36:so=01;35:pi=33:ex=01;32:bd=01;33:cd=01;33:su=37;41:sg=30;43:tw=30;42:ow=34;42'
case $OSTYPE in
  darwin*) ;;
  *) alias ls='ls --color=auto' ;;
esac
alias grep='grep --color=auto'

# tailscale: on macOS the command lives inside the app, on linux it's a normal command
if [[ $OSTYPE == darwin* ]] && [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
  alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi

# take a big video (like a photobooth export) and make it smaller
shrinkvid() {
  ffmpeg -i "$1" -c:v libx265 -crf "${2:-28}" -preset slow -tag:v hvc1 \
    -c:a aac -b:a 96k "${1%.*}_smaller.mov"
}
